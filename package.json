{
  "name": "scenewright",
  "version": "0.1.0",
  "description": "Open-source, AI-assisted, editable motion graphics: brief \u2192 validated scene graph \u2192 preview \u2192 MP4.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "render": "tsx src/cli/render.ts",
    "validate": "tsx src/cli/validate.ts",
    "schema": "tsx scripts/export-schema.ts",
    "licenses": "node scripts/license-report.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@napi-rs/canvas": "^1.0.13",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
