# SceneWright configuration. Copy to .env (never commit .env). Everything is optional:
# without any AI provider the built-in offline planner is used.

# --- Server ---
# HOST=127.0.0.1          # bind address (no authentication: keep it on localhost)
# PORT=8787               # API port (the Vite dev server proxies to it)
# DATA_DIR=./data         # projects, uploaded assets and rendered videos
# MAX_UPLOAD_MB=25

# --- Rendering ---
# FFMPEG_PATH=ffmpeg      # path to an ffmpeg binary with libx264
# FFPROBE_PATH=ffprobe

# --- AI planner: Anthropic Claude (optional) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium # low | medium | high

# --- AI planner: any OpenAI-compatible server (optional) ---
# Ollama example: OPENAI_BASE_URL=http://127.0.0.1:11434/v1  OPENAI_MODEL=llama3.1
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
